# Copy to .env and fill in: cp .env.example .env

# Required: answer generation (Microsoft Foundry, OpenAI-compatible endpoint)
FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=<api-key>
FOUNDRY_DEPLOYMENT_NAME=<chat-model-deployment>

# Optional: LLM judge for the evaluation (test/run_eval.py --generation --judge).
# Leave empty if unused. FOUNDRY_ENDPOINT is the resource endpoint from the
# Microsoft-Decision-1.1 deployment page (https://<resource>.services.ai.azure.com/),
# not the /openai/v1 URL above.
FOUNDRY_ENDPOINT=
FOUNDRY_DECISION_DEPLOYMENT=
